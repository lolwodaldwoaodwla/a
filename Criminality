        local pts = { Vector3.new(0,0,0) }; local twoPi = math.pi * 2
        for i = 1, point_amount do
            local b = 0.5; local v = 0; local k = i
            while k > 0 do if k % 2 == 1 then v = v + b end; k = math.floor(k / 2); b = b * 0.5 end
            local u = i / point_amount; local theta = twoPi * v; local phi = math.acos(1 - 2 * u); local sin_phi = math.sin(phi)
