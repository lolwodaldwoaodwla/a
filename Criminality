                local scrPos, onScr = Camera:WorldToViewportPoint(aimPos)
                if onScr then
                local dx = scrPos.X - mouseLoc.X
                local dy = scrPos.Y - mouseLoc.Y
                local dist2D = math.sqrt(dx * dx + dy * dy)
                if dist2D < shortest then
