function getWepsInClass(cls) if not SkinsDB[cls] then return {} end; local w = {}; for wn, _ in pairs(SkinsDB[cls]) do table.insert(w, wn) end; table.sort(w); return w end
function getSkinsForWep(cls, wn) if not SkinsDB[cls] or not SkinsDB[cls][wn] then return {} end; local s = {}; for sn, _ in pairs(SkinsDB[cls][wn]) do table.insert(s, sn) end; table.sort(s); return s end

function applySkin()
    if not SkinState.On then Notifications:Create({Name = "Enable SkinChanger first!", LifeTime = 2}); return false end
    if not SkinState.Weapon or not SkinState.Skin then Notifications:Create({Name = "Select weapon and skin!", LifeTime = 2}); return false end
    c = LocalPlayer.Character; if not c then Notifications:Create({Name = "No char!", LifeTime = 2}); return false end
    t = c:FindFirstChild(SkinState.Weapon); if not t then Notifications:Create({Name = "Equip "..SkinState.Weapon.." first!", LifeTime = 2}); return false end
    sData = SkinsDB[SkinState.Class][SkinState.Weapon][SkinState.Skin]; if not sData then Notifications:Create({Name = "No skin data!", LifeTime = 2}); return false end    local suc, err = pcall(function()
        for _, d in pairs(t:GetDescendants()) do if d:IsA("MeshPart") then d.TextureID = sData.id; if d:FindFirstChildOfClass("SurfaceAppearance") then d:FindFirstChildOfClass("SurfaceAppearance"):Destroy() end end end
        if sData.customApply then sData.customApply(t) end
    end)
    if suc then Notifications:Create({Name = "Skin to "..SkinState.Weapon, LifeTime = 2}); return true else warn("Skin err:", err); Notifications:Create({Name = "Skin fail!", LifeTime = 2}); return false end
end

function setupAutoApply()
    for _, c in pairs(SkinState.Conns) do if c then c:Disconnect() end end; SkinState.Conns = {}
    if SkinState.On and SkinState.Auto then
        function chkAndApply()
            if not SkinState.Auto or not SkinState.On then return end
            c = LocalPlayer.Character; if not c then return end
            t = c:FindFirstChild(SkinState.Weapon); if not t then return end            if SkinState.Weapon and SkinState.Skin then task.wait(0.5); applySkin() end
        end
        if LocalPlayer.Character then local t = LocalPlayer.Character:FindFirstChild(SkinState.Weapon); if t then task.spawn(function() task.wait(1); chkAndApply() end) end end
        local c1 = LocalPlayer.CharacterAdded:Connect(function(c) task.wait(2); chkAndApply() end)
        function setupCharMon(c) local c2 = c.ChildAdded:Connect(function(ch) if ch:IsA("Tool") and ch.Name == SkinState.Weapon then task.wait(0.5); chkAndApply() end end); table.insert(SkinState.Conns, c2) end
        if LocalPlayer.Character then setupCharMon(LocalPlayer.Character) end
        local c3 = LocalPlayer.CharacterAdded:Connect(function(c) task.wait(1); setupCharMon(c); chkAndApply() end)
        table.insert(SkinState.Conns, c1); table.insert(SkinState.Conns, c3)
    end
end

function saveSkins() if writefile then pcall(function() writefile("starlight_skins.json", game:GetService("HttpService"):JSONEncode(SkinState.Equipped)) end) else Notifications:Create({Name = "No writefile", LifeTime = 2}) end end
function loadSkins() if readfile and isfile then pcall(function() if isfile("starlight_skins.json") then SkinState.Equipped = game:GetService("HttpService"):JSONDecode(readfile("starlight_skins.json")) end end) end end

