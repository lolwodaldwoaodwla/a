                local target_char = target_player.Character
                if target_char then
                    local target_head = target_char:FindFirstChild("Head")
                    local target_humanoid = target_char:FindFirstChildOfClass("Humanoid")
                    if target_head and target_humanoid and (not RB.CheckDead or target_humanoid.Health > 0) then
                        local local_char = LocalPlayer.Character
                        if local_char then
                            local local_hrp = local_char:FindFirstChild("HumanoidRootPart")
                            local local_tool = local_char:FindFirstChildOfClass("Tool")
                            if local_hrp and local_tool then
                                local tool_values = local_tool:FindFirstChild("Values")
                                local hitmarker = local_tool:FindFirstChild("Hitmarker")
                                if tool_values and hitmarker then
                                    local server_ammo = tool_values:FindFirstChild("SERVER_Ammo")
                                    local stored_ammo = tool_values:FindFirstChild("SERVER_StoredAmmo")
                                    if server_ammo and stored_ammo and server_ammo.Value > 0 then
                                        local priority_parts = {}
                                        for _, name in ipairs({"Head", "UpperTorso", "HumanoidRootPart", "Torso"}) do
                                            local p = target_char:FindFirstChild(name)
                                            if p then table.insert(priority_parts, p) end
                                        end
                                        local hit_found = false; local direction_vector; local random_origin = local_hrp.Position
                                        local hit_part_name = "Body"; local final_hit_pos = nil

                                        if RB.SphereMode == "Femboy Fibonacci" then
                                            local R = math.clamp(RB.SphereRadius, 1, 19)
                                            local femboy_offsets = generate_femboy_fibonacci_offsets(R, 40)
                                            table.insert(femboy_offsets, 1, Vector3.new(0,0,0))
                                            local femboy_ignore = { Workspace.CurrentCamera, LocalPlayer.Character, target_char }
                                            for _, shoot_offset in ipairs(femboy_offsets) do
                                                if hit_found then break end
                                                local shoot_pos = local_hrp.Position + shoot_offset
                                                for _, part in ipairs(priority_parts) do
                                                    if hit_found then break end
                                                    for _, hit_offset in ipairs(femboy_offsets) do
                                                        local hit_pos = part.Position + hit_offset
                                                        if is_femboy_path_clear(shoot_pos, hit_pos, femboy_ignore) then
                                                            random_origin = shoot_pos; final_hit_pos = hit_pos
                                                            direction_vector = (hit_pos - shoot_pos).Unit * 1000
                                                            hit_found = true; hit_part_name = part.Name; break
                                                        end
                                                    end
                                                end
                                            end
                                        else
                                            local offsets = (function()
                                                local R = math.clamp(RB.SphereRadius, 1, 19); local N = 19
                                                if RB.SphereMode == "Vector" then
                                                    local pts = {}
                                                    for _ = 1, N do pts[#pts + 1] = Vector3.new(math.random(-18,18), math.random(-18,18), math.random(-18,18)) end
                                                    return pts
                                                end
                                                if RB.SphereMode == "Random" then
                                                    local pts = { Vector3.new(0,0,0), Vector3.new(0,R,0) }
                                                    for _, point in ipairs(get_random_sphere_offsets(N, R)) do pts[#pts + 1] = point end
                                                    return pts
                                                end
                                                if RB.SphereMode == "Cardinals" then
                                                    local pts = { Vector3.new(0,0,0), Vector3.new(0,R,0) }
                                                    for _, point in ipairs(get_cardinal_offsets(N, R)) do pts[#pts + 1] = point end
                                                    return pts
                                                end
                                                if RB.SphereMode == "Hammersley" then return get_hammersley_offsets(N, R) end
                                                local phi = (1 + math.sqrt(5)) * 0.5; local twoPi = math.pi * 2
                                                local rim = {}
                                                for i = 0, N - 1 do
                                                    local t = (i + 0.5) / N; local y = 1 - t; local r = math.sqrt(1 - y * y)
                                                    local theta = twoPi * i / phi; local x = r * math.cos(theta); local z = r * math.sin(theta)
                                                    rim[#rim + 1] = { pos = Vector3.new(x * R, y * R, z * R), r = r }
                                                end
                                                table.sort(rim, function(a, b) return a.r > b.r end)
                                                local pts = { Vector3.new(0,0,0), Vector3.new(0,R,0) }
                                                for _, point in ipairs(rim) do pts[#pts + 1] = point.pos end
                                                local M = 19; local lower_rim = {}
                                                for i = 0, M - 1 do
                                                    local t = (i + 0.5) / M; local y = -(1 - t); local r = math.sqrt(1 - y * y)
                                                    local theta = twoPi * i / phi; local x = r * math.cos(theta); local z = r * math.sin(theta)
                                                    lower_rim[#lower_rim + 1] = { pos = Vector3.new(x * R, y * R, z * R), r = r }
                                                end
                                                table.sort(lower_rim, function(a, b) return a.r > b.r end)
                                                pts[#pts + 1] = Vector3.new(0, -R, 0)
                                                for _, point in ipairs(lower_rim) do pts[#pts + 1] = point.pos end
                                                return pts
                                            end)()
                                            for _, offset in ipairs(offsets) do
                                                if hit_found then break end
                                                local candidate_origin = local_hrp.Position + offset
                                                for _, part in ipairs(priority_parts) do
                                                    local hit_pos = part.Position; local to_hit = hit_pos - candidate_origin; local unit_dir = to_hit.Unit
                                                    local ray_result = raycast_function(candidate_origin, to_hit)
                                                    local path_clear = (not ray_result) or ray_result.Instance:IsDescendantOf(target_char)
                                                    if path_clear then
                                                        random_origin = candidate_origin; direction_vector = unit_dir * 1000
                                                        hit_found = true; hit_part_name = part.Name; break
                                                    end
                                                end
                                            end
                                        end

                                        if hit_found then
                                            local random_id = generate_random_string(30) .. 0
                                            pcall(function() start_shoot_event:FireServer(tick(), random_id, local_tool, "FDS9I83", random_origin, { direction_vector }, false) end)
                                            local hit_pos_to_send = (RB.SphereMode == "Femboy Fibonacci" and final_hit_pos) or target_head.Position
                                            local delay_time = (1 - (RB.FireRate or 50) / 100) * 0.2
                                            task.wait(delay_time)
                                            pcall(function() finish_shoot_event:FireServer("\xF0\x9F\xA7\x88", local_tool, random_id, 1, target_head, hit_pos_to_send, direction_vector) end)
                                            pcall(function()
                                                local gnxr = events:FindFirstChild("GNX_R")
                                                if gnxr then gnxr:FireServer(tick(), "KLWE89U0", local_tool) end
                                            end)
                                            if HSett.On then
                                                if HSett.Method == "Hit Check" then
                                                    local hm = local_tool:FindFirstChild("Hitmarker")
                                                    if hm then
                                                        local old_id = HSound.SoundId
                                                        HSound.SoundId = HSett.SoundId; HSound.Volume = HSett.Vol
                                                        PlayHSound()
                                                    end
                                                elseif HSett.Method == "ID Swap" then
                                                    PlayHSound()
                                                end
                                            end
                                            if HitLogSett.On and (tick() - HitLogSett.LastLogTime) >= HitLogSett.MinInterval then
                                                HitLogSett.LastLogTime = tick()
                                                local hit_dist = (local_hrp.Position - target_head.Position).Magnitude
                                                local msg = string.format("[%s] hit %s | HP: %d | Dist: %dst", hit_part_name, target_player.Name, math.max(target_humanoid.Health, 0), math.round(hit_dist))
                                                if HitLogSett.Method == "Library" then Notifications:Create({Name = msg, LifeTime = 2})
                                                elseif HitLog then HitLog:Notify(msg) end
                                            end
                                        else RunService.RenderStepped:Wait() end
                                    end
                                end
                            end
                        end
                    end
                end
            end
            RunService.RenderStepped:Wait()
        end
    end)
    Notifications:Create({Name = "Ragebot ON", LifeTime = 2})
end

local function RB_Disable()
    if not RB.Enabled then return end
    RB.Enabled = false
    if RB_LoopTask then pcall(task.cancel, RB_LoopTask); RB_LoopTask = nil end
    if RB_TPHitTask then pcall(task.cancel, RB_TPHitTask); RB_TPHitTask = nil end
    if RB_SkyboxTask then pcall(task.cancel, RB_SkyboxTask); RB_SkyboxTask = nil end
    if RB.FovUpdateConn then RB.FovUpdateConn:Disconnect(); RB.FovUpdateConn = nil end
    if RB.TargetLineConn then RB.TargetLineConn:Disconnect(); RB.TargetLineConn = nil end
    if RB.FovCircle then pcall(function() RB.FovCircle:Remove() end); RB.FovCircle = nil end
    if RB.TargetLineObj then pcall(function() RB.TargetLineObj:Remove() end); RB.TargetLineObj = nil end
    Notifications:Create({Name = "Ragebot OFF", LifeTime = 2})
end

do
    local AntiAim_Enabled = false
    local AntiAim_Mode = "Off"
    local AntiAim_Connection = nil
    local AntiAim_YawAngle = 0

    local function AntiAim_Update(dt)
        if not AntiAim_Enabled then return end
        local myChar = LocalPlayer.Character
        if not myChar then return end
        local myHRP = myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end
        if AntiAim_Mode == "Spin" then
            AntiAim_YawAngle = AntiAim_YawAngle + (P.AntiAim_SpinSpeed / 50)
        elseif AntiAim_Mode == "Jitter" then
            local jitDir
            if (tick() * (P.AntiAim_JitterSpeed / 10) % 2 < 1) then
                jitDir = 1
            else
                jitDir = -1
            end
            AntiAim_YawAngle = jitDir * 90
        else
            return
        end
        myHRP.CFrame = CFrame.new(myHRP.Position) * CFrame.Angles(0, math.rad(AntiAim_YawAngle), 0)
    end

    AntiAim_Enable = function()
        if AntiAim_Enabled then return end
        AntiAim_Enabled = true
        AntiAim_YawAngle = 0
        if not AntiAim_Connection then
            AntiAim_Connection = RunService.Heartbeat:Connect(AntiAim_Update)
        end
    end

    AntiAim_Disable = function()
        if not AntiAim_Enabled then return end
        AntiAim_Enabled = false
        AntiAim_YawAngle = 0
        if AntiAim_Connection then
            AntiAim_Connection:Disconnect(); AntiAim_Connection = nil
        end
    end

    _G.Pidors_AntiAimMode = function(v)
        AntiAim_Mode = v
        if AntiAim_Mode ~= "Off" and not AntiAim_Enabled then
            AntiAim_Enable()
        elseif AntiAim_Mode == "Off" and AntiAim_Enabled then
            AntiAim_Disable()
        end
    end


end

