        local doHp = P.ESP_Health
        local doTracers = P.ESP_Tracers
        local doChams = P.ESP_Chams
        local doSkel = P.ESP_Skeleton
        local doTool = P.ESP_Tool
        local anyDrawing = doBoxes or doNames or doDist or doHp or doTracers or doSkel or doTool
        local skelFrame = (ESP_Frame % 2 == 0)

        for Player, d in pairs(ESP_Drawings) do
            ESP_ProcessPlayer(Player, d, Camera, camPos, vpX, vpY, doBoxes, doNames, doDist, doHp, doTracers, doChams, doSkel, doTool, anyDrawing, skelFrame)
        end
    end

    local _iter_plr = Players:GetPlayers()
    for _, plr in ipairs(_iter_plr) do
        if plr ~= LocalPlayer then ESP_Create(plr) end
    end
    Players.PlayerAdded:Connect(function(plr) ESP_Create(plr) end)
