function loadCMSubzeroModel()
    local success = pcall(function()
        possibleNames = {"subzero","m4a1_subzero","m4_subzero","subzero_m4","subzero_m4a1","ice","frost","frozen"}
        searchLocations = {game:GetService("ReplicatedStorage"),game:GetService("Workspace"),game:GetService("Lighting"),game:GetService("StarterPack"),game:GetService("StarterGui"),game:GetService("ServerStorage")}
        storage = game:GetService("ReplicatedStorage"):FindFirstChild("Storage")        if storage then
            for _, child in ipairs(storage:GetChildren()) do
                childName = child.Name:lower()                for _, name in ipairs(possibleNames) do
                    if string.find(childName, name) then
                        cmSubzeroModel = child:Clone()
                        return true
                    end
                end
            end
        end
        for _, location in ipairs(searchLocations) do
            if location then
                function searchInContainer(container, depth)
                    if depth > 3 then return false end
                    for _, item in ipairs(container:GetChildren()) do
                        itemName = item.Name:lower()                        for _, name in ipairs(possibleNames) do
                            if string.find(itemName, name) then
                                if item:IsA("Model") or item:IsA("BasePart") or item:IsA("MeshPart") then
                                    cmSubzeroModel = item:Clone()
                                    return true
                                end
                            end
                        end
                        if #item:GetChildren() > 0 then
                            if searchInContainer(item, depth + 1) then return true end
                        end
                    end
                    return false
                end
                if searchInContainer(location, 0) then return true end
            end
        end
        function findAnyWeaponModel(container)
            for _, item in ipairs(container:GetChildren()) do
                itemName = item.Name:lower()                if string.find(itemName, "weapon") or string.find(itemName, "gun") or string.find(itemName, "rifle") or string.find(itemName, "m4") then
                    if item:IsA("Model") or item:IsA("BasePart") then
                        cmSubzeroModel = item:Clone()
                        return true
                    end
                end
                if #item:GetChildren() > 0 then
                    if findAnyWeaponModel(item) then return true end
                end
            end
            return false
        end
        if storage and findAnyWeaponModel(storage) then return true end
        return false
    end)
    if success and cmSubzeroModel then
        for _, obj in ipairs(cmSubzeroModel:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.CanCollide = false
                obj.Massless = true
                obj.CastShadow = false
                obj.CanQuery = false
                complexMaterials = {Enum.Material.Neon,Enum.Material.Glass,Enum.Material.Foil,Enum.Material.ForceField}                for _, material in ipairs(complexMaterials) do
                    if obj.Material == material then obj.Material = Enum.Material.Plastic end
                end
            end
        end
        return true
    else
        return false
    end
end

function applyCMSubzeroSkin(weapon)
