                    end
                    return
                else
                    stickyPlayer = nil
                    stickyPart = nil
                    stickyLocked = false
                end
            else
                local target = findTarget()
                if target then
                    stickyPlayer = target.player
                    stickyPart = target.part
                    stickyLocked = true
                end
                return
            end
        end

        local target = findTarget()
        if target then aimAt(target) end
    end)

