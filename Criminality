                d.Tool.Position = Vector2.new(rPos.X, lPos.Y + (doDist and 20 or 5))
                d.Tool.Color = P.ESP_ToolColor; d.Tool.Visible = true
            elseif d.Tool.Visible then d.Tool.Visible = false end
        elseif d.Tool.Visible then d.Tool.Visible = false end

        if doSkel then
            if skelFrame then
                local boneCount = cache.IsR15 and #boneR15 or #boneR6
                local bones = cache.Bones
                for i = 1, boneCount do
                    local ln = d.Skeleton[i]
                    local bp = bones[i]
                    if bp and bp.p1 and bp.p2 and bp.p1.Parent and bp.p2.Parent then
                        local a = Camera:WorldToViewportPoint(bp.p1.Position)
                        local b = Camera:WorldToViewportPoint(bp.p2.Position)
                        ln.From = Vector2.new(a.X, a.Y); ln.To = Vector2.new(b.X, b.Y)
                        ln.Color = P.ESP_SkelColor; ln.Visible = true
                    elseif ln.Visible then ln.Visible = false end
                end
                for i = boneCount + 1, #d.Skeleton do
                    if d.Skeleton[i].Visible then d.Skeleton[i].Visible = false end
                end
            end
        else
            for _, ln in ipairs(d.Skeleton) do
                if ln.Visible then ln.Visible = false end
            end
        end

        if doChams then
            local hl = ESP_Highlights[Player]
            if not hl or not hl.Parent then
                hl = nil
                ESP_Highlights[Player] = nil
            end
            if not hl then
                hl = Instance.new("Highlight"); hl.Adornee = Char
                hl.FillTransparency = 0.5; hl.OutlineTransparency = 0
                pcall(function() hl.Parent = game:GetService("CoreGui") end)
                if not hl.Parent then hl.Parent = LocalPlayer:WaitForChild("PlayerGui") end
                ESP_Highlights[Player] = hl
            elseif hl.Adornee ~= Char then
                hl.Adornee = Char
            end
            hl.FillColor = P.ESP_ChamsFill
            hl.OutlineColor = P.ESP_ChamsOutline
            hl.Enabled = true
        else
            local hl = ESP_Highlights[Player]
            if hl then
                hl.Enabled = false
                pcall(function() hl:Destroy() end)
                ESP_Highlights[Player] = nil
            end
        end
    end

    local function ESP_Update()
        ESP_Frame = ESP_Frame + 1
        local Camera = Workspace.CurrentCamera
        local camPos = Camera.CFrame.Position
        local vpSize = Camera.ViewportSize
        local vpX, vpY = vpSize.X, vpSize.Y
        local doBoxes = P.ESP_Boxes
        local doNames = P.ESP_Names
