    local function ESP_ProcessPlayer(Player, d, Camera, camPos, vpX, vpY, doBoxes, doNames, doDist, doHp, doTracers, doChams, doSkel, doTool, anyDrawing, skelFrame)
        local cache = ESP_PartCache[Player]
        local Char = Player.Character

        if not Char or not Char.Parent or not cache or not cache.Root or not cache.Root.Parent then
            if anyDrawing then ESP_HideAll(d) end
            if ESP_Highlights[Player] then
                pcall(function() ESP_Highlights[Player]:Destroy() end); ESP_Highlights[Player] = nil
            end
            ESP_PartCache[Player] = nil
            if Char and Char.Parent then
                local root = Char:FindFirstChild("HumanoidRootPart")
                if root then CacheCharParts(Player, Char) end
            end
            cache = ESP_PartCache[Player]
            if not cache or not cache.Root or not cache.Root.Parent then return end
        end

        local Root = cache.Root
        local Hum = cache.Hum
        if not Root or not Root.Parent or not Hum then
            if anyDrawing then ESP_HideAll(d) end
            return
        end

        if Hum.Health <= 0 then
            local bodyEff = Char:FindFirstChild("BodyEffects")
            local knocked = bodyEff and bodyEff:FindFirstChild("Knocked")
            if not (knocked and knocked.Value) then
                if anyDrawing then ESP_HideAll(d) end
                if ESP_Highlights[Player] then
                    pcall(function() ESP_Highlights[Player]:Destroy() end); ESP_Highlights[Player] = nil
                end
                return
            end
        end

        local rootPos = Root.Position
        local dist = (camPos - rootPos).Magnitude
        if dist > P.ESP_MaxDist then
            if anyDrawing then ESP_HideAll(d) end
            if not doChams and ESP_Highlights[Player] then
                pcall(function() ESP_Highlights[Player]:Destroy() end)
                ESP_Highlights[Player] = nil
            elseif ESP_Highlights[Player] then
                ESP_Highlights[Player].Enabled = false
            end
            return
        end

        local rPos, onScr = Camera:WorldToViewportPoint(rootPos)
        if not onScr then
            if anyDrawing then ESP_HideAll(d) end
            if not doChams and ESP_Highlights[Player] then
                pcall(function() ESP_Highlights[Player]:Destroy() end)
                ESP_Highlights[Player] = nil
            elseif ESP_Highlights[Player] then
                ESP_Highlights[Player].Enabled = false
            end
            return
        end

        local Head = cache.Head
        if not Head or not Head.Parent then
            Head = Char:FindFirstChild("Head")
            cache.Head = Head
        end
        local headOffset = Head and (Head.Position + Vector3.new(0, 0.5, 0)) or (rootPos + Vector3.new(0, 2, 0))
        local hPos = Camera:WorldToViewportPoint(headOffset)
        local lPos = Camera:WorldToViewportPoint(rootPos - Vector3.new(0, 3, 0))
        local h = math.abs(hPos.Y - lPos.Y)
        local w = h / 2
        local halfW = w / 2
        local boxLeft = rPos.X - halfW

        if doBoxes then
            d.Box.Size = Vector2.new(w, h); d.Box.Position = Vector2.new(boxLeft, hPos.Y)
            d.Box.Color = P.ESP_BoxColor; d.Box.Visible = true
        elseif d.Box.Visible then d.Box.Visible = false end

        if doNames then
            d.Name.Text = Player.DisplayName or Player.Name; d.Name.Position = Vector2.new(rPos.X, hPos.Y - 20)
            d.Name.Color = P.ESP_NameColor; d.Name.Visible = true
        elseif d.Name.Visible then d.Name.Visible = false end

        if doDist then
            d.Dist.Text = "[" .. math.floor(dist) .. "m]"; d.Dist.Position = Vector2.new(rPos.X, lPos.Y + 5)
            d.Dist.Color = P.ESP_DistColor; d.Dist.Visible = true
        elseif d.Dist.Visible then d.Dist.Visible = false end

        if doHp then
            local maxHp = Hum.MaxHealth > 0 and Hum.MaxHealth or 100
            local rawHp = Hum.Health
            if rawHp <= 0 then rawHp = maxHp end
            local hs = math.clamp(rawHp / maxHp, 0, 1)
            d.HpBg.Size = Vector2.new(4, h); d.HpBg.Position = Vector2.new(boxLeft - 6, hPos.Y); d.HpBg.Visible = true
            d.Hp.Size = Vector2.new(2, h * hs); d.Hp.Position = Vector2.new(boxLeft - 5, hPos.Y + h * (1 - hs))
            d.Hp.Color = Color3.new(1 - hs, hs, 0); d.Hp.Visible = true
        else
            if d.HpBg.Visible then d.HpBg.Visible = false end
            if d.Hp.Visible then d.Hp.Visible = false end
        end

        if doTracers then
            local orig = Vector2.new(vpX / 2, vpY)
            local tracerOrigin = P.ESP_TracerOrigin
            if tracerOrigin == "Center" then orig = Vector2.new(vpX / 2, vpY / 2)
            elseif tracerOrigin == "Mouse" then orig = UserInputService:GetMouseLocation() end
            d.Tracer.From = orig; d.Tracer.To = Vector2.new(rPos.X, lPos.Y)
            d.Tracer.Color = P.ESP_TracerColor; d.Tracer.Visible = true
        elseif d.Tracer.Visible then d.Tracer.Visible = false end

        if doTool then
            local ToolItem = Char:FindFirstChildOfClass("Tool")
            if ToolItem then
