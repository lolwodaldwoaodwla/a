function changeCMFireSoundsPlaybackSpeed(weapon, soundEffectsTable)
    if not weapon then return end
    weaponHandle = weapon:FindFirstChild("WeaponHandle") or weapon:FindFirstChild("Handle")    if not weaponHandle then return end
    muzzle = weaponHandle:FindFirstChild("Muzzle")    if muzzle then
        for i = 1, 3 do
            fireSound = muzzle:FindFirstChild("FireSound" .. i)            if fireSound and fireSound:IsA("Sound") then
                soundEffectsTable[fireSound] = {PlaybackSpeed = fireSound.PlaybackSpeed, SoundId = fireSound.SoundId}
                fireSound.PlaybackSpeed = 0.952
            end
        end
        alternativeSoundNames = {"Fire", "Shoot", "Gunshot", "Shot", "FireSound"}        for _, soundName in pairs(alternativeSoundNames) do
            sound = muzzle:FindFirstChild(soundName)            if sound and sound:IsA("Sound") and not soundEffectsTable[sound] then
                soundEffectsTable[sound] = {PlaybackSpeed = sound.PlaybackSpeed, SoundId = sound.SoundId}
                sound.PlaybackSpeed = 0.8
            end
        end
    end
    for _, sound in pairs(weaponHandle:GetChildren()) do
        if sound:IsA("Sound") and not soundEffectsTable[sound] then
            soundName = sound.Name:lower()            if string.find(soundName, "fire") or string.find(soundName, "shoot") or string.find(soundName, "shot") or string.find(soundName, "firesound") then
                soundEffectsTable[sound] = {PlaybackSpeed = sound.PlaybackSpeed, SoundId = sound.SoundId}
                sound.PlaybackSpeed = 0.8
            end
        end
    end
    for _, sound in pairs(weapon:GetDescendants()) do
        if sound:IsA("Sound") and not soundEffectsTable[sound] then
            soundName = sound.Name:lower()            if string.find(soundName, "fire") or string.find(soundName, "shoot") or string.find(soundName, "shot") or string.find(soundName, "firesound") then
                soundEffectsTable[sound] = {PlaybackSpeed = sound.PlaybackSpeed, SoundId = sound.SoundId}
                sound.PlaybackSpeed = 0.8
            end
        end
    end
end

function restoreCMFireSoundsPlaybackSpeed(soundEffectsTable)
    for sound, originalData in pairs(soundEffectsTable) do
        if sound and sound.Parent then
            pcall(function() sound.PlaybackSpeed = originalData.PlaybackSpeed end)
        end
    end
    soundEffectsTable = {}
end

