    if not weapon then return false end
    if weapon.Name == "Sawn-Off" then return true end
    weaponName = weapon.Name:lower()
    keywords = {"sawnoff","sawedoff","sawed-off","sawn-off","shotgun","double barrel","double-barrel","db"}    for _, keyword in ipairs(keywords) do if string.find(weaponName, keyword) then return true end end
    return false
end

