    local SA = Tabs.Combat:Section({Name = 'Silent Aim', Side = 'Left'})
    local SA_FovCircle = nil
    local SA_CurrentTarget = nil
    local SA_Task = nil

    local ValidSilentTargetParts = {"Head", "HumanoidRootPart", "UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "RightUpperArm", "RightLowerArm", "LeftUpperLeg", "LeftLowerLeg", "RightUpperLeg", "RightLowerLeg"}

    local function SA_GetTarget()
        local closest = nil
        local shortest = math.huge
        local cam = Workspace.CurrentCamera
        local mouseLoc = UserInputService:GetMouseLocation()
        local charStats = ReplicatedStorage:FindFirstChild('CharStats')

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local eChar = plr.Character
                if not eChar then continue end
                local eHum = eChar:FindFirstChildOfClass('Humanoid')
                if not eHum or eHum.Health <= 0 then continue end
                if P.SilentAim_CheckDowned and charStats then
                    local pStats = charStats:FindFirstChild(plr.Name)
                    if pStats then
                        local downed = pStats:FindFirstChild('Downed')
                        if downed and downed.Value == true then continue end
                    end
                end
                if eChar:FindFirstChildOfClass('ForceField') then continue end
                for _, partName in ipairs(P.SilentAim_TargetParts) do
                    local part = eChar:FindFirstChild(partName)
                    if part then
                        if P.SilentAim_WallCheck then
                            local origin = cam.CFrame.Position
                            local dir = (part.Position - origin)
                            local rayParams = RaycastParams.new()
                            rayParams.FilterType = Enum.RaycastFilterType.Exclude
                            rayParams.FilterDescendantsInstances = {LocalPlayer.Character}
                            local result = Workspace:Raycast(origin, dir, rayParams)
                            if result and result.Instance and not result.Instance:IsDescendantOf(eChar) then continue end
                        end
                        local vp, onScr = cam:WorldToViewportPoint(part.Position)
                        if onScr then
                            local dx = vp.X - mouseLoc.X
                            local dy = vp.Y - mouseLoc.Y
                            local dist = math.sqrt(dx * dx + dy * dy)
                            if dist <= P.SilentAim_Fov and dist < shortest then
                                shortest = dist
                                closest = plr
                            end
                        end
                    end
                end
            end
        end
        return closest
    end

    local function SA_UpdateCircle()
        if SA_FovCircle then
            pcall(function()
                SA_FovCircle.Radius = P.SilentAim_Fov
                SA_FovCircle.Visible = P.SilentAim_Draw and toggle_states.SilentAim
                local mp = UserInputService:GetMouseLocation()
                SA_FovCircle.Position = Vector2.new(mp.X, mp.Y)
            end)
        end
    end

    local SA_VisualizeConn = nil

    local function SA_GetHitPart(targetPlayer)
        local plr = targetPlayer or SA_CurrentTarget
        if not plr or not plr.Character then return nil end
        local char = plr.Character
        local hum = char:FindFirstChildOfClass('Humanoid')
        if not hum or hum.Health <= 0 then return nil end
        if char:FindFirstChildOfClass('ForceField') then return nil end
        local partStr = P.SilentAim_TargetPartMode
        local mousePos = UserInputService:GetMouseLocation()
        local cam = Workspace.CurrentCamera
        if partStr == "Closest" then
            local minPartDistance = math.huge
            local bestPart = nil
            for _, partName in ipairs(ValidSilentTargetParts) do
                local part = char:FindFirstChild(partName)
                if part then
                    local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local distance = (Vector2.new(mousePos.X, mousePos.Y) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                        if distance < minPartDistance then
                            minPartDistance = distance
                            bestPart = part
                        end
                    end
                end
            end
            return bestPart
        elseif partStr == "Random" then
            return char:FindFirstChild(ValidSilentTargetParts[math.random(1, #ValidSilentTargetParts)])
        else
            return char:FindFirstChild(partStr) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
        end
    end

    local function SA_Start()
        SA_UpdateCircle()
        SA_Task = task.spawn(function()
            while toggle_states.SilentAim do
                SA_CurrentTarget = SA_GetTarget()
                RunService.Heartbeat:Wait()
            end
        end)
        local VisualizeEvent = ReplicatedStorage:FindFirstChild('Events2') and ReplicatedStorage.Events2:FindFirstChild('Visualize')
        local DamageEvent = ReplicatedStorage:FindFirstChild('Events') and ReplicatedStorage.Events:FindFirstChild('ZFKLF__H')
        if not VisualizeEvent or not DamageEvent then
            Notifications:Create({Name = 'Silent Aim: Events not found', LifeTime = 3})
            toggle_states.SilentAim = false
            return
        end
        SA_VisualizeConn = VisualizeEvent.Event:Connect(function(_, ShotCode, _, Gun, _, StartPos, BulletsPerShot)
            if not toggle_states.SilentAim then return end
            if not Gun or not SA_CurrentTarget or not SA_CurrentTarget.Character or SA_CurrentTarget.Character:FindFirstChildOfClass('ForceField') then return end
            local playerTool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass('Tool')
            if not playerTool or Gun ~= playerTool then return end
            if math.random(1, 100) > P.SilentAim_Chance then return end

            local HitPart = SA_GetHitPart()
            if not HitPart then return end

            local HitPos = HitPart.Position
            local Bullets = {}
            for i = 1, math.clamp(#BulletsPerShot, 1, 100) do
                table.insert(Bullets, CFrame.new(StartPos, HitPos).LookVector)
            end
            task.wait(0.005)
            for Index, LookVector in ipairs(Bullets) do
                DamageEvent:FireServer("\xF0\x9F\xA7\x88", Gun, ShotCode, Index, HitPart, HitPos, LookVector)
            end
            pcall(function()
                if Gun:FindFirstChild('Hitmarker') then
                    Gun.Hitmarker:Fire(HitPart)
                end
            end)
            if HSett.On then PlayHSound() end
        end)
        Notifications:Create({Name = 'Silent Aim ON', LifeTime = 2})
    end

    local function SA_Stop()
        SA_CurrentTarget = nil
        if SA_Task then pcall(task.cancel, SA_Task); SA_Task = nil end
        if SA_VisualizeConn then SA_VisualizeConn:Disconnect(); SA_VisualizeConn = nil end
        SA_UpdateCircle()
    end

